{
  "name": "rock-to-rack",
  "version": "0.0.0",
  "description": "A browser game about the semiconductor supply chain from raw minerals to data-center racks.",
  "private": true,
  "license": "UNLICENSED",
  "homepage": "https://rock-to-rack.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Omarzaf/rock-to-rack.git"
  },
  "bugs": {
    "url": "https://github.com/Omarzaf/rock-to-rack/issues"
  },
  "keywords": [
    "game",
    "semiconductors",
    "supply-chain",
    "phaser",
    "vite"
  ],
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "dev": "vite",
    "audio:generate": "node tools/generate-audio-assets.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "simulate": "vitest run src/sim/playthroughSimulator.test.ts --reporter=verbose",
    "test": "vitest run",
    "verify:static": "vitest run src/ship/siteMetadata.test.ts src/ship/staticFiles.test.ts",
    "smoke:m10": "node tools/m10-browser-smoke.mjs",
    "smoke:m11": "node tools/m11-browser-smoke.mjs",
    "smoke:m12": "node tools/m12-replay-smoke.mjs",
    "smoke:m13": "node tools/m13-ch4-keyboard-smoke.mjs",
    "perf:m10": "node tools/m10-performance-smoke.mjs"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^24.0.0",
    "typescript": "^5.8.3",
    "vite": "^8.2.2",
    "vitest": "^3.2.4"
  }
}
